---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import MateriaCanvas from '../../components/MateriaCanvas.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
	.filter((post) => post.id.startsWith('en/'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Materia Programable" description="Exploring the future of programmable matter: artificial intelligence, nanotechnology, soft robotics, self-assembly and neuromorphic computing." />
        <link rel="alternate" hreflang="es" href="https://www.materiaprogramable.com/" />
        <link rel="alternate" hreflang="en" href="https://www.materiaprogramable.com/en/" />
        <link rel="alternate" hreflang="x-default" href="https://www.materiaprogramable.com/" />
        <style>
            .category-section {
                margin-top: 4rem;
            }
            .category-section h2 {
                color: var(--accent);
                border-bottom: 2px solid var(--glass-border);
                padding-bottom: 0.5rem;
                margin-bottom: 0.5rem;
                text-shadow: 0 0 10px rgba(0, 240, 255, 0.4);
            }
            .category-desc {
                color: rgb(var(--gray-light));
                opacity: 0.8;
                font-size: 0.9em;
                margin-bottom: 1.5rem;
                font-style: italic;
            }
            .post-grid {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
                gap: 1.5rem;
            }
            .post-card {
                padding: 1.5em;
                text-decoration: none !important;
                display: flex;
                flex-direction: column;
            }
            .post-card h4 {
                font-size: 1.4rem;
                margin-bottom: 0.5rem;
                color: #fff;
            }
            .post-card .date {
                font-size: 0.8rem;
                color: var(--accent);
                margin-bottom: 1rem;
            }
            .post-card p {
                font-size: 0.9rem;
                color: rgb(var(--gray-light));
                margin: 0;
            }
            .post-card img {
                margin-bottom: 1rem;
                aspect-ratio: 16/9;
                object-fit: cover;
            }
            .empty-state {
                padding: 2rem;
                text-align: center;
                border: 1px dashed var(--glass-border);
                border-radius: 8px;
                opacity: 0.6;
            }
        </style>
	</head>
	<body>
        <MateriaCanvas />
		<Header />
		<main>
            <section class="glass-panel" style="margin-bottom: 3rem; padding: 1rem; position: relative;">
                <div style="margin-top: 2rem;border-radius: 8px;overflow: hidden;">
                    <video controls style="width:100%;display:block;border-radius:8px;" poster="">
                        <source src="/media/Materia_Programable1.mp4" type="video/mp4">
                    </video>
                </div>
            </section>

            <section class="category-section">
                <h2>Latest Research</h2>
                <p class="category-desc">Exploring the frontiers of programmable matter, smart materials, and autonomous systems.</p>
                <div class="post-grid">
                    {posts.map((post) => (
                        <a href={`/blog/${post.id}/`} class="glass-panel post-card">
                            {post.data.heroImage && <img src={post.data.heroImage} alt="" />}
                            <h4>{post.data.title}</h4>
                            <span class="date">
                                <time datetime={post.data.pubDate.toISOString()}>
                                    {post.data.pubDate.toLocaleDateString('en-US', {
                                        year: 'numeric',
                                        month: 'short',
                                        day: 'numeric',
                                    })}
                                </time>
                            </span>
                            <p>{post.data.description}</p>
                        </a>
                    ))}
                </div>
            </section>
		</main>
		<Footer />
	</body>
</html>
