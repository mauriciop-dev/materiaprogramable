---
// ArticleCanvas.astro - Configurable Three.js animation for blog articles
interface Props {
  theme?: string;
  primaryColor?: string;
  secondaryColor?: string;
  particleCount?: number;
  shape?: string;
  movement?: string;
  speed?: number;
  interaction?: string;
  cameraMode?: string;
  specialEffects?: string;
}

const {
  theme = "sci-fi",
  primaryColor = "#00ffff",
  secondaryColor = "#8b5cf6",
  particleCount = 1500,
  shape = "particles",
  movement = "floating",
  speed = 1.0,
  interaction = "mouse",
  cameraMode = "auto-rotate",
  specialEffects = "glow"
} = Astro.props;
---

<div id="article-canvas-container" class="fixed inset-0 z-[-1] bg-black" data-theme={theme} data-primary={primaryColor} data-secondary={secondaryColor} data-count={particleCount} data-shape={shape} data-movement={movement} data-speed={speed} data-interaction={interaction} data-camera={cameraMode} data-effects={specialEffects}></div>

<script>
  import * as THREE from 'three';

  const container = document.getElementById('article-canvas-container');
  if (!container) throw new Error('Canvas container not found');

  // Get params from data attributes or global window object
  const globalParams = window.ARTICLE_ANIM_PARAMS || {};
  const params = {
    theme: globalParams.theme || container.dataset.theme || 'sci-fi',
    primary: new THREE.Color(globalParams.primaryColor || container.dataset.primary || '#00ffff'),
    secondary: new THREE.Color(globalParams.secondaryColor || container.dataset.secondary || '#8b5cf6'),
    count: parseInt(globalParams.particleCount || container.dataset.count) || 1500,
    shape: globalParams.shape || container.dataset.shape || 'particles',
    movement: globalParams.movement || container.dataset.movement || 'floating',
    speed: parseFloat(globalParams.speed || container.dataset.speed) || 1.0,
    interaction: globalParams.interaction || container.dataset.interaction || 'mouse',
    camera: globalParams.cameraMode || container.dataset.camera || 'auto-rotate',
    effects: globalParams.specialEffects || container.dataset.effects || 'glow'
  };

  // Scene setup
  const scene = new THREE.Scene();
  scene.fog = new THREE.FogExp2(0x010409, 0.002);

  const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
  camera.position.z = 40;

  // Add Lights for MeshStandardMaterial (used in boids)
  const ambientLight = new THREE.AmbientLight(0xffffff, 0.5);
  scene.add(ambientLight);
  const pointLight = new THREE.PointLight(params.primary, 2, 100);
  pointLight.position.set(0, 0, 20);
  scene.add(pointLight);

  const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  container.appendChild(renderer.domElement);

  // Create particles based on shape
  let particles, geometry, positions, colors, instancedMesh, boidsVelocities;
  let instancedTargets, lineGeometry, linePositions, shaderMesh;
  let extraMeshes = [];

  function createParticles() {
    const count = params.count;
    
    if (params.shape === 'boids') {
      const boxGeo = new THREE.BoxGeometry(0.1, 0.1, 0.1);
      const computedCyan = getComputedStyle(document.body).getPropertyValue('--neon-cyan').trim() || '#00ffff';
      const boxMat = new THREE.MeshStandardMaterial({ 
        color: computedCyan, 
        roughness: 0.2, 
        metalness: 0.8,
        emissive: new THREE.Color(computedCyan).multiplyScalar(0.2)
      });
      instancedMesh = new THREE.InstancedMesh(boxGeo, boxMat, count);
      boidsVelocities = new Float32Array(count * 3);
      
      const dummy = new THREE.Object3D();
      for (let i = 0; i < count; i++) {
        dummy.position.set((Math.random() - 0.5) * 30, (Math.random() - 0.5) * 30, (Math.random() - 0.5) * 30);
        dummy.updateMatrix();
        instancedMesh.setMatrixAt(i, dummy.matrix);
        
        boidsVelocities[i*3] = (Math.random() - 0.5) * 0.2;
        boidsVelocities[i*3+1] = (Math.random() - 0.5) * 0.2;
        boidsVelocities[i*3+2] = (Math.random() - 0.5) * 0.2;
      }
      scene.add(instancedMesh);
      return;
    }

    // Instanced Cubes — self-assembling blocks
    if (params.shape === 'instanced-cubes') {
      const boxGeo = new THREE.BoxGeometry(0.3, 0.3, 0.3);
      const boxMat = new THREE.MeshStandardMaterial({
        color: params.primary,
        roughness: 0.3,
        metalness: 0.7,
        emissive: params.primary.clone().multiplyScalar(0.15)
      });
      instancedMesh = new THREE.InstancedMesh(boxGeo, boxMat, count);
      const cols = Math.ceil(Math.pow(count, 1/3));
      const spacing = 1.5;
      const offset = (cols - 1) * spacing * 0.5;
      instancedTargets = new Float32Array(count * 3);
      boidsVelocities = new Float32Array(count * 3);

      const dummy = new THREE.Object3D();
      for (let i = 0; i < count; i++) {
        const ix = i % cols;
        const iy = Math.floor(i / cols) % cols;
        const iz = Math.floor(i / (cols * cols));
        instancedTargets[i*3] = ix * spacing - offset;
        instancedTargets[i*3+1] = iy * spacing - offset;
        instancedTargets[i*3+2] = iz * spacing - offset;
        dummy.position.set((Math.random() - 0.5) * 40, (Math.random() - 0.5) * 40, (Math.random() - 0.5) * 40);
        dummy.updateMatrix();
        instancedMesh.setMatrixAt(i, dummy.matrix);
        boidsVelocities[i*3] = (Math.random() - 0.5) * 0.3;
        boidsVelocities[i*3+1] = (Math.random() - 0.5) * 0.3;
        boidsVelocities[i*3+2] = (Math.random() - 0.5) * 0.3;
      }
      instancedMesh.instanceMatrix.needsUpdate = true;
      scene.add(instancedMesh);
      return;
    }

    // Instanced Nodes — connected network with lines
    if (params.shape === 'instanced-nodes') {
      const sphereGeo = new THREE.SphereGeometry(0.15, 8, 8);
      const nodeMat = new THREE.MeshStandardMaterial({
        color: params.primary,
        emissive: params.primary.clone().multiplyScalar(0.4),
        roughness: 0.2,
        metalness: 0.3
      });
      instancedMesh = new THREE.InstancedMesh(sphereGeo, nodeMat, count);
      instancedTargets = new Float32Array(count * 3);
      boidsVelocities = new Float32Array(count * 3);

      const dummy = new THREE.Object3D();
      for (let i = 0; i < count; i++) {
        const angle1 = Math.random() * Math.PI * 2;
        const angle2 = Math.random() * Math.PI * 2;
        const radius = 5 + Math.random() * 15;
        instancedTargets[i*3] = radius * Math.sin(angle1) * Math.cos(angle2);
        instancedTargets[i*3+1] = radius * Math.sin(angle1) * Math.sin(angle2);
        instancedTargets[i*3+2] = radius * Math.cos(angle1);
        dummy.position.copy(new THREE.Vector3(instancedTargets[i*3], instancedTargets[i*3+1], instancedTargets[i*3+2]));
        dummy.updateMatrix();
        instancedMesh.setMatrixAt(i, dummy.matrix);
        boidsVelocities[i*3] = (Math.random() - 0.5) * 0.01;
        boidsVelocities[i*3+1] = (Math.random() - 0.5) * 0.01;
        boidsVelocities[i*3+2] = (Math.random() - 0.5) * 0.01;
      }
      instancedMesh.instanceMatrix.needsUpdate = true;
      scene.add(instancedMesh);

      // Create connection lines between nearby nodes
      const linePositionsArray = [];
      for (let i = 0; i < count; i++) {
        for (let j = i + 1; j < count; j++) {
          const dx = instancedTargets[i*3] - instancedTargets[j*3];
          const dy = instancedTargets[i*3+1] - instancedTargets[j*3+1];
          const dz = instancedTargets[i*3+2] - instancedTargets[j*3+2];
          const dist = Math.sqrt(dx*dx + dy*dy + dz*dz);
          if (dist < 6 && Math.random() < 0.15) {
            linePositionsArray.push(instancedTargets[i*3], instancedTargets[i*3+1], instancedTargets[i*3+2]);
            linePositionsArray.push(instancedTargets[j*3], instancedTargets[j*3+1], instancedTargets[j*3+2]);
          }
        }
      }
      if (linePositionsArray.length > 0) {
        const lineGeo = new THREE.BufferGeometry();
        linePositions = new Float32Array(linePositionsArray);
        lineGeo.setAttribute('position', new THREE.BufferAttribute(linePositions, 3));
        const lineMat = new THREE.LineBasicMaterial({
          color: params.secondary,
          transparent: true,
          opacity: 0.15
        });
        lineGeometry = new THREE.LineSegments(lineGeo, lineMat);
        scene.add(lineGeometry);
      }
      return;
    }

    // DNA Helix
    if (params.shape === 'dna-helix') {
      const sphereGeo = new THREE.SphereGeometry(0.12, 6, 6);
      const nodeMat = new THREE.MeshStandardMaterial({
        color: params.primary,
        emissive: params.primary.clone().multiplyScalar(0.3),
        roughness: 0.3,
        metalness: 0.5
      });
      const strandCount = Math.floor(count / 2);
      instancedMesh = new THREE.InstancedMesh(sphereGeo, nodeMat, strandCount * 2);
      const dummy = new THREE.Object3D();
      const turns = 4;
      const height = 35;
      boidsVelocities = new Float32Array(strandCount * 3);

      for (let i = 0; i < strandCount; i++) {
        const t = (i / strandCount) * Math.PI * 2 * turns;
        const y = (i / strandCount - 0.5) * height;
        const radius = 6;

        // Strand 1
        dummy.position.set(radius * Math.cos(t), y, radius * Math.sin(t));
        dummy.updateMatrix();
        instancedMesh.setMatrixAt(i, dummy.matrix);

        // Strand 2 (offset by PI)
        dummy.position.set(radius * Math.cos(t + Math.PI), y, radius * Math.sin(t + Math.PI));
        dummy.updateMatrix();
        instancedMesh.setMatrixAt(i + strandCount, dummy.matrix);

        boidsVelocities[i*3] = t;
        boidsVelocities[i*3+1] = y;
        boidsVelocities[i*3+2] = radius;
      }
      instancedMesh.instanceMatrix.needsUpdate = true;
      scene.add(instancedMesh);

      // Rungs between strands
      const rungPositions = [];
      for (let i = 0; i < strandCount; i += 2) {
        const t = (i / strandCount) * Math.PI * 2 * turns;
        const y = (i / strandCount - 0.5) * height;
        const radius = 6;
        rungPositions.push(radius * Math.cos(t), y, radius * Math.sin(t));
        rungPositions.push(radius * Math.cos(t + Math.PI), y, radius * Math.sin(t + Math.PI));
      }
      if (rungPositions.length > 0) {
        const rungGeo = new THREE.BufferGeometry();
        rungGeo.setAttribute('position', new THREE.BufferAttribute(new Float32Array(rungPositions), 3));
        const rungMat = new THREE.LineBasicMaterial({
          color: params.secondary,
          transparent: true,
          opacity: 0.3
        });
        const rungs = new THREE.LineSegments(rungGeo, rungMat);
        scene.add(rungs);
        extraMeshes.push(rungs);
      }
      return;
    }

    // Custom Shader Wave — animated wave surface with ShaderMaterial
    if (params.shape === 'custom-shader-wave') {
      const width = 40, segments = 80;
      const shaderGeo = new THREE.BufferGeometry();
      const verts = [];
      const uvs = [];
      const indices = [];
      for (let i = 0; i <= segments; i++) {
        for (let j = 0; j <= segments; j++) {
          verts.push((i / segments - 0.5) * width, 0, (j / segments - 0.5) * width);
          uvs.push(i / segments, j / segments);
        }
      }
      for (let i = 0; i < segments; i++) {
        for (let j = 0; j < segments; j++) {
          const a = i * (segments + 1) + j;
          const b = i * (segments + 1) + j + 1;
          const c = (i + 1) * (segments + 1) + j;
          const d = (i + 1) * (segments + 1) + j + 1;
          indices.push(a, b, c, b, d, c);
        }
      }
      shaderGeo.setAttribute('position', new THREE.BufferAttribute(new Float32Array(verts), 3));
      shaderGeo.setAttribute('uv', new THREE.BufferAttribute(new Float32Array(uvs), 2));
      shaderGeo.setIndex(indices);
      shaderGeo.computeVertexNormals();

      const shaderMat = new THREE.ShaderMaterial({
        uniforms: {
          uTime: { value: 0 },
          uColor1: { value: params.primary },
          uColor2: { value: params.secondary },
          uSpeed: { value: params.speed }
        },
        vertexShader: `
          uniform float uTime;
          uniform float uSpeed;
          varying vec3 vPosition;
          varying float vHeight;
          void main() {
            vec3 pos = position;
            float wave1 = sin(pos.x * 0.5 + uTime * 0.8 * uSpeed) * 0.8;
            float wave2 = cos(pos.z * 0.4 + uTime * 0.6 * uSpeed) * 0.6;
            float wave3 = sin((pos.x + pos.z) * 0.3 + uTime * 0.4 * uSpeed) * 0.4;
            pos.y = wave1 + wave2 + wave3;
            vHeight = (pos.y + 1.8) / 3.6;
            vPosition = pos;
            gl_Position = projectionMatrix * modelViewMatrix * vec4(pos, 1.0);
          }
        `,
        fragmentShader: `
          uniform vec3 uColor1;
          uniform vec3 uColor2;
          varying float vHeight;
          varying vec3 vPosition;
          void main() {
            vec3 color = mix(uColor1, uColor2, vHeight);
            float alpha = 0.7 + vHeight * 0.3;
            gl_FragColor = vec4(color, alpha * 0.5);
          }
        `,
        transparent: true,
        wireframe: false,
        side: THREE.DoubleSide,
      });
      shaderMesh = new THREE.Mesh(shaderGeo, shaderMat);
      scene.add(shaderMesh);

      // Add a wireframe overlay for tech look
      const wireMat = new THREE.ShaderMaterial({
        uniforms: { uTime: { value: 0 }, uSpeed: { value: params.speed } },
        vertexShader: `
          uniform float uTime;
          uniform float uSpeed;
          void main() {
            vec3 pos = position;
            float wave1 = sin(pos.x * 0.5 + uTime * 0.8 * uSpeed) * 0.8;
            float wave2 = cos(pos.z * 0.4 + uTime * 0.6 * uSpeed) * 0.6;
            float wave3 = sin((pos.x + pos.z) * 0.3 + uTime * 0.4 * uSpeed) * 0.4;
            pos.y = wave1 + wave2 + wave3;
            gl_Position = projectionMatrix * modelViewMatrix * vec4(pos, 1.0);
          }
        `,
        fragmentShader: `void main() { gl_FragColor = vec4(0.0, 1.0, 1.0, 0.15); }`,
        transparent: true,
        wireframe: true,
      });
      const wireMesh = new THREE.Mesh(shaderGeo.clone(), wireMat);
      scene.add(wireMesh);
      extraMeshes.push(wireMesh);
      return;
    }

    // Magnetic Field — particles flowing along invisible field lines
    if (params.shape === 'magnetic-field') {
      const magCount = Math.min(count, 2000);
      geometry = new THREE.BufferGeometry();
      positions = new Float32Array(magCount * 3);
      colors = new Float32Array(magCount * 3);
      const magPositions = new Float32Array(magCount * 3);
      boidsVelocities = new Float32Array(magCount);

      for (let i = 0; i < magCount; i++) {
        const angle = Math.random() * Math.PI * 2;
        const height = (Math.random() - 0.5) * 30;
        const radius = 2 + Math.random() * 12;
        const spiralOffset = Math.random() * Math.PI * 4;
        positions[i*3] = radius * Math.cos(angle + spiralOffset);
        positions[i*3+1] = height;
        positions[i*3+2] = radius * Math.sin(angle + spiralOffset);
        magPositions[i*3] = angle;
        magPositions[i*3+1] = height;
        magPositions[i*3+2] = radius;
        const mixRatio = (radius - 2) / 12;
        const color = new THREE.Color().lerpColors(params.primary, params.secondary, mixRatio);
        colors[i*3] = color.r;
        colors[i*3+1] = color.g;
        colors[i*3+2] = color.b;
        boidsVelocities[i] = 0.2 + Math.random() * 0.5;
      }
      geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
      geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));
      const magMat = new THREE.PointsMaterial({
        size: 0.15,
        vertexColors: true,
        transparent: true,
        opacity: 0.8,
        blending: THREE.AdditiveBlending
      });
      particles = new THREE.Points(geometry, magMat);
      scene.add(particles);
      // Store extra data for animation
      particles.userData.magPositions = magPositions;
      return;
    }

    // Fluid Atoms — organic floating particles with fluid-like motion
    if (params.shape === 'fluid-atoms') {
      geometry = new THREE.BufferGeometry();
      const fluidCount = Math.min(count, 2500);
      positions = new Float32Array(fluidCount * 3);
      colors = new Float32Array(fluidCount * 3);
      boidsVelocities = new Float32Array(fluidCount * 3);

      for (let i = 0; i < fluidCount; i++) {
        const theta = Math.random() * Math.PI * 2;
        const phi = Math.acos(2 * Math.random() - 1);
        const r = 2 + Math.random() * 14;
        positions[i*3] = r * Math.sin(phi) * Math.cos(theta);
        positions[i*3+1] = r * Math.sin(phi) * Math.sin(theta);
        positions[i*3+2] = r * Math.cos(phi);
        const mixRatio = (r - 2) / 14;
        const color = new THREE.Color().lerpColors(params.primary, params.secondary, mixRatio);
        colors[i*3] = color.r;
        colors[i*3+1] = color.g;
        colors[i*3+2] = color.b;
        boidsVelocities[i*3] = theta;
        boidsVelocities[i*3+1] = phi;
        boidsVelocities[i*3+2] = r;
      }
      geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
      geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));

      const fluidMat = new THREE.PointsMaterial({
        size: 0.18,
        vertexColors: true,
        transparent: true,
        opacity: 0.7,
        blending: THREE.AdditiveBlending
      });
      particles = new THREE.Points(geometry, fluidMat);
      scene.add(particles);
      return;
    }

    geometry = new THREE.BufferGeometry();
    positions = new Float32Array(count * 3);
    colors = new Float32Array(count * 3);

    const primary = params.primary;
    const secondary = params.secondary;

    for (let i = 0; i < count; i++) {
      const i3 = i * 3;
      
      // Shape-specific positioning
      switch (params.shape) {
        case 'spheres':
          const theta = Math.random() * Math.PI * 2;
          const phi = Math.acos(2 * Math.random() - 1);
          const r = 15 + Math.random() * 10;
          positions[i3] = r * Math.sin(phi) * Math.cos(theta);
          positions[i3 + 1] = r * Math.sin(phi) * Math.sin(theta);
          positions[i3 + 2] = r * Math.cos(phi);
          break;
        case 'cubes':
          positions[i3] = (Math.random() - 0.5) * 30;
          positions[i3 + 1] = (Math.random() - 0.5) * 30;
          positions[i3 + 2] = (Math.random() - 0.5) * 30;
          break;
        case 'helix':
          const t = (i / count) * Math.PI * 8;
          const radius = 10 + Math.random() * 3;
          positions[i3] = radius * Math.cos(t);
          positions[i3 + 1] = (i / count - 0.5) * 40;
          positions[i3 + 2] = radius * Math.sin(t);
          break;
        case 'network':
          positions[i3] = (Math.random() - 0.5) * 40;
          positions[i3 + 1] = (Math.random() - 0.5) * 40;
          positions[i3 + 2] = (Math.random() - 0.5) * 40;
          break;
        case 'waves':
          positions[i3] = (i / count - 0.5) * 50;
          positions[i3 + 1] = Math.sin(i / count * Math.PI * 4) * 5;
          positions[i3 + 2] = (Math.random() - 0.5) * 20;
          break;
        default: // particles
          positions[i3] = (Math.random() - 0.5) * 50;
          positions[i3 + 1] = (Math.random() - 0.5) * 50;
          positions[i3 + 2] = (Math.random() - 0.5) * 50;
      }

      // Color mixing
      const mixRatio = Math.random();
      const color = new THREE.Color().lerpColors(primary, secondary, mixRatio);
      colors[i3] = color.r;
      colors[i3 + 1] = color.g;
      colors[i3 + 2] = color.b;
    }

    geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));

    // Material based on effects
    let material;
    if (params.effects === 'wireframe') {
      material = new THREE.PointsMaterial({
        size: 0.3,
        vertexColors: true,
        wireframe: true,
        transparent: true,
        opacity: 0.6
      });
    } else if (params.effects === 'transparent') {
      material = new THREE.PointsMaterial({
        size: 0.2,
        vertexColors: true,
        transparent: true,
        opacity: 0.4
      });
    } else if (params.effects === 'trails') {
      material = new THREE.PointsMaterial({
        size: 0.15,
        vertexColors: true,
        transparent: true,
        opacity: 0.7,
        blending: THREE.AdditiveBlending
      });
    } else { // glow (default)
      material = new THREE.PointsMaterial({
        size: 0.2,
        vertexColors: true,
        transparent: true,
        opacity: 0.8,
        blending: THREE.AdditiveBlending
      });
    }

    particles = new THREE.Points(geometry, material);
    scene.add(particles);
  }

  createParticles();

  // Mouse interaction
  let mouseX = 0, mouseY = 0, targetX = 0, targetY = 0;
  const halfX = window.innerWidth / 2;
  const halfY = window.innerHeight / 2;

  if (params.interaction !== 'none') {
    document.addEventListener('mousemove', (e) => {
      mouseX = (e.clientX - halfX) * 0.001;
      mouseY = (e.clientY - halfY) * 0.001;
    });
  }

  // Animation
  const clock = new THREE.Clock();
  let frame = 0;
  const dummy = new THREE.Object3D();
  const mat4 = new THREE.Matrix4();
  const vec3 = new THREE.Vector3();

  function animate() {
    const elapsed = clock.getElapsedTime();
    const delta = clock.getDelta();
    frame++;

    targetX += (mouseX - targetX) * 0.05;
    targetY += (mouseY - targetY) * 0.05;

    // Movement patterns
    const speedMult = params.speed;

    // Custom Shader Wave — update uniforms
    if (params.shape === 'custom-shader-wave' && shaderMesh) {
      shaderMesh.material.uniforms.uTime.value = elapsed;
      if (extraMeshes[0] && extraMeshes[0].material) {
        extraMeshes[0].material.uniforms.uTime.value = elapsed;
      }
    }

    // Magnetic field particles — flow along spiral paths
    if (params.shape === 'magnetic-field' && particles && particles.userData.magPositions) {
      const posArray = geometry.attributes.position.array;
      const magData = particles.userData.magPositions;
      for (let i = 0; i < posArray.length / 3; i++) {
        const i3 = i * 3;
        magData[i3] += 0.01 * speedMult * boidsVelocities[i];
        const angle = magData[i3];
        const height = magData[i3+1];
        const radius = magData[i3+2];
        posArray[i3] = radius * Math.cos(angle);
        posArray[i3+1] = height + Math.sin(elapsed * 0.5 + i * 0.01) * 0.5;
        posArray[i3+2] = radius * Math.sin(angle);
      }
      geometry.attributes.position.needsUpdate = true;
    }

    // Fluid atoms — organic organic swirling motion
    if (params.shape === 'fluid-atoms' && geometry) {
      const posArray = geometry.attributes.position.array;
      for (let i = 0; i < posArray.length / 3; i++) {
        const i3 = i * 3;
        let theta = boidsVelocities[i3];
        let phi = boidsVelocities[i3+1];
        const r = boidsVelocities[i3+2];
        theta += 0.002 * speedMult;
        phi += 0.001 * speedMult * Math.sin(elapsed * 0.3 + i * 0.01);
        boidsVelocities[i3] = theta;
        boidsVelocities[i3+1] = phi;
        posArray[i3] = r * Math.sin(phi) * Math.cos(theta);
        posArray[i3+1] = r * Math.sin(phi) * Math.sin(theta);
        posArray[i3+2] = r * Math.cos(phi);
      }
      geometry.attributes.position.needsUpdate = true;
    }

    // Self-assembly — instanced cubes moving to target grid positions
    if ((params.shape === 'instanced-cubes' || (params.movement === 'self-assembly' && instancedMesh)) && instancedTargets) {
      const dummy = new THREE.Object3D();
      const mat4 = new THREE.Matrix4();
      const vec3 = new THREE.Vector3();
      for (let i = 0; i < params.count; i++) {
        instancedMesh.getMatrixAt(i, mat4);
        vec3.setFromMatrixPosition(mat4);
        const i3 = i * 3;
        vec3.x += (instancedTargets[i3] - vec3.x) * 0.01 * speedMult;
        vec3.y += (instancedTargets[i3+1] - vec3.y) * 0.01 * speedMult;
        vec3.z += (instancedTargets[i3+2] - vec3.z) * 0.01 * speedMult;
        dummy.position.copy(vec3);
        dummy.rotation.x += 0.01 * speedMult;
        dummy.rotation.y += 0.02 * speedMult;
        dummy.updateMatrix();
        instancedMesh.setMatrixAt(i, dummy.matrix);
      }
      instancedMesh.instanceMatrix.needsUpdate = true;
    }

    // Instanced nodes — gentle floating + connection pulsing
    if (params.shape === 'instanced-nodes' && instancedMesh && instancedTargets) {
      const dummy = new THREE.Object3D();
      const mat4 = new THREE.Matrix4();
      const vec3 = new THREE.Vector3();
      for (let i = 0; i < params.count; i++) {
        instancedMesh.getMatrixAt(i, mat4);
        vec3.setFromMatrixPosition(mat4);
        const i3 = i * 3;
        vec3.x += (instancedTargets[i3] + Math.sin(elapsed * 0.3 + i * 0.1) * 1.5 - vec3.x) * 0.005 * speedMult;
        vec3.y += (instancedTargets[i3+1] + Math.cos(elapsed * 0.2 + i * 0.1) * 1.5 - vec3.y) * 0.005 * speedMult;
        vec3.z += (instancedTargets[i3+2] + Math.sin(elapsed * 0.4 + i * 0.1) * 1.5 - vec3.z) * 0.005 * speedMult;
        dummy.position.copy(vec3);
        dummy.updateMatrix();
        instancedMesh.setMatrixAt(i, dummy.matrix);
      }
      instancedMesh.instanceMatrix.needsUpdate = true;

      // Pulse line opacity
      if (lineGeometry) {
        lineGeometry.material.opacity = 0.1 + Math.sin(elapsed * 0.5) * 0.05;
      }
    }

    // DNA Helix — slow rotation
    if (params.shape === 'dna-helix' && instancedMesh) {
      instancedMesh.rotation.y += 0.003 * speedMult;
      extraMeshes.forEach(m => { m.rotation.y += 0.003 * speedMult; });
    }

    if (params.shape === 'boids' && instancedMesh) {
      for (let i = 0; i < params.count; i++) {
        instancedMesh.getMatrixAt(i, mat4);
        vec3.setFromMatrixPosition(mat4);
        
        const i3 = i * 3;
        // Boids simplified: move towards center slightly (cohesion), separate if too close, add noise
        let centerDirX = -vec3.x * 0.001;
        let centerDirY = -vec3.y * 0.001;
        let centerDirZ = -vec3.z * 0.001;
        
        // Mouse interaction for boids
        if (params.interaction !== 'none') {
            centerDirX += (targetX * 10 - vec3.x) * 0.005;
            centerDirY += (targetY * 10 - vec3.y) * 0.005;
        }

        boidsVelocities[i3] += centerDirX + (Math.random() - 0.5) * 0.02;
        boidsVelocities[i3+1] += centerDirY + (Math.random() - 0.5) * 0.02;
        boidsVelocities[i3+2] += centerDirZ + (Math.random() - 0.5) * 0.02;
        
        // limit speed
        const speedSq = boidsVelocities[i3]**2 + boidsVelocities[i3+1]**2 + boidsVelocities[i3+2]**2;
        if (speedSq > 0.04) {
          const m = 0.2 / Math.sqrt(speedSq);
          boidsVelocities[i3] *= m; boidsVelocities[i3+1] *= m; boidsVelocities[i3+2] *= m;
        }

        vec3.x += boidsVelocities[i3] * speedMult;
        vec3.y += boidsVelocities[i3+1] * speedMult;
        vec3.z += boidsVelocities[i3+2] * speedMult;
        
        dummy.position.copy(vec3);
        dummy.lookAt(vec3.x + boidsVelocities[i3], vec3.y + boidsVelocities[i3+1], vec3.z + boidsVelocities[i3+2]);
        dummy.updateMatrix();
        instancedMesh.setMatrixAt(i, dummy.matrix);
      }
      instancedMesh.instanceMatrix.needsUpdate = true;
    } else if (geometry) {
      const posArray = geometry.attributes.position.array;

      switch (params.movement) {
        case 'pulsing':
          const scale = 1 + Math.sin(elapsed * speedMult) * 0.1;
          particles.scale.set(scale, scale, scale);
          break;
        case 'flowing':
          for (let i = 0; i < params.count; i++) {
            const i3 = i * 3;
            posArray[i3 + 1] += Math.sin(elapsed + posArray[i3] * 0.1) * 0.02 * speedMult;
          }
          geometry.attributes.position.needsUpdate = true;
          break;
        case 'orbiting':
          particles.rotation.y += 0.002 * speedMult;
          particles.rotation.x += 0.001 * speedMult;
          break;
        case 'swarming':
          posArray[0] += Math.sin(elapsed * 2) * 0.1;
          posArray[1] += Math.cos(elapsed * 2) * 0.1;
          geometry.attributes.position.needsUpdate = true;
          break;
        case 'floating':
        default:
          for (let i = 0; i < params.count; i++) {
            const i3 = i * 3;
            posArray[i3 + 1] += Math.sin(elapsed * 0.5 + i * 0.01) * 0.01 * speedMult;
          }
          geometry.attributes.position.needsUpdate = true;
      }
    }

    // Camera modes
    if (params.camera === 'auto-rotate') {
      camera.position.x = Math.sin(elapsed * 0.2) * 5;
      camera.position.y = Math.cos(elapsed * 0.2) * 5;
      camera.lookAt(scene.position);
    } else if (params.camera === 'orbit') {
      if (particles) {
        particles.rotation.y = targetX * 2;
        particles.rotation.x = targetY * 2;
      }
      if (instancedMesh) {
        instancedMesh.rotation.y = targetX * 2;
        instancedMesh.rotation.x = targetY * 2;
      }
    }

    renderer.render(scene, camera);
    requestAnimationFrame(animate);
  }

  animate();

  // Resize handler
  window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  });
</script>

