# PAIC 2.0 - Environment Variables Template
# Copiar este archivo a .env.local y completar con tus credenciales
# NUNCA commitear .env.local al repositorio

# ========================================
# SUPABASE (Base de Datos + Auth + RLS)
# ========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ========================================
# GEMINI AI (Backend - FASE 1)
# ========================================
GEMINI_API_KEY=your-gemini-api-key-here

# ========================================
# RESEND (Email - Solo para críticos)
# ========================================
RESEND_API_KEY=your-resend-api-key-here

# ========================================
# TWILIO (Optional - Citofonía con llamadas)
# ========================================
# Descomentear si se usa Twilio para VoIP
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_PHONE_NUMBER=+1234567890

# ========================================
# WEB PUSH (PWA - FASE 2)
# ========================================
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# ========================================
# VERCEL
# ========================================
VERCEL_ENV=development
# development, preview, production

# ========================================
# NEXT.JS
# ========================================
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3000

# ========================================
# DESARROLLO
# ========================================
DEBUG=false
LOG_LEVEL=info
# debug, info, warn, error
